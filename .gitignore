# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# WordPress production backups and generated content
/arquivoswordpress/
**/wp-config.php
**/wp-config-*.php
!**/wp-config-sample.php
**/wp-content/cache/
**/wp-content/upgrade/
**/wp-content/backups*/
**/wp-content/uploads/
**/wp-content/debug.log

# Database dumps and backup archives
*.sql
*.sql.gz
*.dump
*.bak
*.backup
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.wpress

# Credentials not covered by .env patterns
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
service-account*.json
