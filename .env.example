# Perfil público: joysticknights ou promogames
NEXT_PUBLIC_SITE_PROFILE=joysticknights
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXING_ENABLED=false

# WordPress continua sendo a origem editorial
WORDPRESS_API_URL=https://joysticknights.com.br/wp-json/wp/v2
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_COMMENTS_SECRET=

# Preview e revalidação assinados (use valores longos e diferentes)
DRAFT_MODE_SECRET=gere-um-segredo-longo
REVALIDATE_SECRET=gere-outro-segredo-longo

# Integrações públicas opcionais, carregadas somente após consentimento
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INLINE=
NEXT_PUBLIC_NEWSLETTER_ACTION=
